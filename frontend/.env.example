# ──────────────────────────────────────────────────────────────────────────────
# Alita Assistant — Frontend Environment Variables
# Copy this file to .env and fill in your own values.
# These VITE_ prefixed vars are injected at BUILD TIME by Vite.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (Auth) ───────────────────────────────────────────────────────────
# NOTE: The Supabase "anon key" is designed to be PUBLIC (used in browser).
# It is NOT a secret — Row Level Security (RLS) protects your data server-side.
# Find these in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Backend WebSocket ─────────────────────────────────────────────────────────
VITE_WS_BACKEND_URL=ws://localhost:8000/ws

# ── TomTom Traffic API (Free tier: 2500 req/day) ──────────────────────────────
# Get key: https://developer.tomtom.com
VITE_TOMTOM_API_KEY=your-tomtom-api-key-here

# ── Google Maps API (3D Photorealistic Tiles / Google Earth) ──────────────────
# Configure HTTP Referrer restrictions in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ── Cesium Ion (Satellite imagery + 3D Terrain) ───────────────────────────────
# Get token: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=your-cesium-ion-token-here
