# ──────────────────────────────────────────────────────────────────────────────
# Aura Assistant — Frontend Environment Variables
# Copy this file to .env.local and fill in your own keys.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase Authentication ──────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── TomTom Traffic API ──────────────────────────────────────────────────────
# Get your free key: https://developer.tomtom.com
VITE_TOMTOM_API_KEY=your-tomtom-api-key-here

# ── Backend Connection ───────────────────────────────────────────────────────
# Leave as-is for local dev. Change for production deployment.
VITE_WS_BACKEND_URL=ws://localhost:8000/ws
