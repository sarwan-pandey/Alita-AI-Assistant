# ──────────────────────────────────────────────────────────────────────────────
# Aura Assistant — Backend Environment Variables
# Copy this file to .env and fill in your own keys.
# ──────────────────────────────────────────────────────────────────────────────

# ── Security (Supabase JWT verification) ─────────────────────────────────────
# Find this in: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── Admin endpoint protection ────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET=generate-a-strong-random-secret-here

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# Get keys from: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
# Webhook secret from: Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
# Subscription plan IDs from: Razorpay Dashboard → Subscriptions → Plans
RAZORPAY_PLAN_MONTHLY=plan_monthly_id_here
RAZORPAY_PLAN_ANNUAL=plan_annual_id_here

# ── DeepSeek API (High accuracy, great medical knowledge) ───────────────────
# Get your free key: https://platform.deepseek.com (10M tokens/month free!)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ── NVIDIA Build API (Nemotron 3 Super — 120B MoE, agentic reasoning) ───────
# Get your free key: https://build.nvidia.com
# Nemotron 3 Super: 120B params, 12B active, 1M context, multilingual
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Google Gemini API Keys ───────────────────────────────────────────────────
# Get free keys from: https://aistudio.google.com/apikey
# TIP: Each key from a DIFFERENT Gmail account = higher total quota!
# Minimum 1 key required. Add up to 10 for best rate limits.
GEMINI_API_KEY=your-gemini-api-key-1
# GEMINI_API_KEY_2=your-gemini-api-key-2
# GEMINI_API_KEY_3=your-gemini-api-key-3
# ... add up to GEMINI_API_KEY_10

# ── Groq API (FREE FALLBACK) ────────────────────────────────────────────────
# When all Gemini keys are exhausted, Aura falls back to Groq automatically.
# Get your free key: https://console.groq.com/keys
# Groq uses Llama 3.3 70B — fast, smart, 30 RPM with NO daily limit!
GROQ_API_KEY=your-groq-api-key-1
# GROQ_API_KEY_2=your-groq-api-key-2
# GROQ_API_KEY_3=your-groq-api-key-3

# ── TomTom Traffic API ──────────────────────────────────────────────────────
# Get your free key: https://developer.tomtom.com
VITE_TOMTOM_API_KEY=your-tomtom-api-key-here

# ── Secure Deployment ────────────────────────────────────────────────────────
# Set to true in production to redirect all HTTP → HTTPS
ENFORCE_HTTPS=false

# Restrict allowed hostnames (comma-separated). Blocks requests with wrong Host header.
# Example: TRUSTED_HOSTS=myapp.com,api.myapp.com
TRUSTED_HOSTS=

# SSL certificates for native HTTPS (alternative to reverse proxy)
# If using Nginx/Caddy as reverse proxy, leave these empty.
SSL_CERTFILE=
SSL_KEYFILE=

# Server port (default 8000)
PORT=8000

# Disable test auth endpoint in production
DISABLE_TEST_AUTH=false

# ── TTS Engine Configuration ────────────────────────────────────────────────
# Options: chatterbox (Default Dual-Engine) | chattts_rollback (Emergency Rollback)
TTS_ENGINE_MODE=chatterbox
TTS_PRELOAD_TURBO=true
TTS_PRELOAD_MULTILINGUAL=false
